# Copy to .env and adjust. All values are optional.

# MongoDB connection string. Leave empty to run without persistence.
# e.g. mongodb://localhost:27017  or  mongodb+srv://<user>:<password>@<cluster>/
MONGO_URI=
MONGO_DB=scam_detection_db

# Comma-separated list of browser origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directory containing sms_*.pkl / email_*.pkl (defaults to backend/models)
MODELS_DIR=

# Full path to tesseract if it is not on PATH
# Windows default after `winget install UB-Mannheim.TesseractOCR`:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

MAX_UPLOAD_BYTES=5242880
LOG_LEVEL=INFO
