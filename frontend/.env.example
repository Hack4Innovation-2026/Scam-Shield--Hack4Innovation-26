# Copy to .env.local (gitignored) and fill in.

# --- Backend -----------------------------------------------------------------
# Leave VITE_API_URL empty in development: Vite proxies /api to BACKEND_URL.
# Set it for production builds or the Android app (emulator -> host is http://10.0.2.2:8000).
VITE_API_URL=
BACKEND_URL=http://localhost:8000

# --- Firebase (optional) -----------------------------------------------------
# Without these the app runs in guest mode (history saved in localStorage).
# Firebase Console -> Project settings -> General -> Your apps -> Web app (</>) -> SDK config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Must be the *web* app id (1:<number>:web:<hex>), not the Android one.
VITE_FIREBASE_APP_ID=
